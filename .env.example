# Database
# Local dev:
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/thrustwise
# Hosted (Neon): any copied format works — the app normalizes the scheme,
# ssl/sslmode, and channel_binding automatically, and supports both the
# direct and the -pooler endpoint (direct preferred):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?ssl=require

# Redis
REDIS_URL=redis://localhost:6379/0

# EODHD
EODHD_API_TOKEN=YOUR_EODHD_TOKEN_HERE

# App
ENVIRONMENT=development
# Comma-separated. Must include the deployed frontend origin.
CORS_ORIGINS=http://localhost:3000,https://thrustwise-finance-ui.vercel.app
CACHE_TTL_SECONDS=86400
INGESTION_HISTORY_YEARS=5

# Operational gates (safe defaults for local dev)
AUTO_CREATE_TABLES=true
RUN_SCHEDULER=true
# Set this to enable POST /api/admin/refresh (endpoint is invisible when unset)
# ADMIN_API_TOKEN=your-secret-admin-token
